# ---- Core ----
DATABASE_URL=postgresql://user:pass@host:5432/postgres
DB_SSL=true
PORT=3000
NODE_ENV=production
CLIENT_URL=https://accessyplabs.com

# ---- Auth (use 64+ char random secrets in production) ----
JWT_SECRET=
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- Clay reasoning engine ----
# OpenAI is the primary provider; set OPENAI_API_KEY (and optionally OPENAI_MODEL).
# Anthropic is an automatic fallback if only ANTHROPIC_API_KEY is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
CLAY_MODEL=claude-sonnet-4-5

# ---- Payments (Stripe Connect; crypto is never a payment method) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (dual-channel delivery via Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Clay at YP Labs <clay@accessyplabs.com>

# Secret for the concept-timeout maintenance job (POST /api/maintenance/expire-concepts
# with header x-maintenance-key). Set this and schedule the endpoint (e.g. Railway cron,
# daily) so abandoned, unsubscribed, unlisted concepts are removed after 30 days.
MAINTENANCE_KEY=

# ---- Image rendering (OPTIONAL; dormant until set) ----
# Turn on "Render a photo" + auto-description. Provider-agnostic: point at your
# chosen image API (aggregator like fal/Replicate, or Imagen/Flux/Ideogram).
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_MODEL=

# ---- Video rendering (OPTIONAL; dormant until set; the most expensive path) ----
VIDEO_API_KEY=
VIDEO_API_URL=
VIDEO_MODEL=
